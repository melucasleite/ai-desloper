# Copy to .env.local. Everything except the AI key is optional:
# without Supabase the app keeps reports in memory and accounts are off.

# Vercel AI Gateway (or run `vercel link` + `vercel env pull` for OIDC).
AI_GATEWAY_API_KEY=

# Supabase. `npx supabase start` prints local values; on Vercel the Supabase
# integration syncs these (`vercel env pull`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...). The legacy anon JWT also works,
# as NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...), server only. The legacy service_role JWT also
# works, as SUPABASE_SERVICE_ROLE_KEY. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Google sign-in (optional). Used by supabase/config.toml for the local stack;
# for a hosted project configure Google under Auth > Providers instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
